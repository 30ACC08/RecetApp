<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.recetapp.ui.fragments.SplashFragment"
        android:label="Splash">
        <action android:id="@+id/action_splashFragment_to_loginFragment" app:destination="@id/loginFragment" app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
        <action android:id="@+id/action_splashFragment_to_homeFragment" app:destination="@id/homeFragment" app:popUpTo="@id/splashFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/loginFragment" android:name="com.example.recetapp.ui.fragments.LoginFragment" android:label="Login">
        <action android:id="@+id/action_loginFragment_to_registerFragment" app:destination="@id/registerFragment" />
        <action android:id="@+id/action_loginFragment_to_homeFragment" app:destination="@id/homeFragment" app:popUpTo="@id/loginFragment" app:popUpToInclusive="true" />
    </fragment>
    <fragment android:id="@+id/registerFragment" android:name="com.example.recetapp.ui.fragments.RegisterFragment" android:label="Registro" />
    <fragment android:id="@+id/homeFragment" android:name="com.example.recetapp.ui.fragments.HomeFragment" android:label="Inicio">
        <action android:id="@+id/action_homeFragment_to_detalleFragment" app:destination="@id/detalleFragment" />
        <action android:id="@+id/action_homeFragment_to_searchFragment" app:destination="@id/searchFragment" />
    </fragment>
    <fragment android:id="@+id/searchFragment" android:name="com.example.recetapp.ui.fragments.SearchFragment" android:label="Buscar">
        <action android:id="@+id/action_searchFragment_to_detalleFragment" app:destination="@id/detalleFragment" />
    </fragment>
    <fragment android:id="@+id/detalleFragment" android:name="com.example.recetapp.ui.fragments.DetalleFragment" android:label="Detalle" />
    <fragment android:id="@+id/favoritosFragment" android:name="com.example.recetapp.ui.fragments.FavoritosFragment" android:label="Favoritos">
        <action android:id="@+id/action_favoritosFragment_to_detalleFragment" app:destination="@id/detalleFragment" />
    </fragment>
    <fragment android:id="@+id/adminFragment" android:name="com.example.recetapp.ui.fragments.AdminFragment" android:label="Administración" />

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.recetapp.ui.fragments.PerfilFragment"
        android:label="Perfil">
        <action android:id="@+id/action_perfilFragment_to_loginFragment" app:destination="@id/loginFragment" app:popUpTo="@id/nav_graph" app:popUpToInclusive="true" />
        <action android:id="@+id/action_perfilFragment_to_adminFragment" app:destination="@id/adminFragment" />
        <action android:id="@+id/action_perfilFragment_to_myRecipesFragment" app:destination="@id/myRecipesFragment" />
    </fragment>

    <fragment
        android:id="@+id/createRecipeFragment"
        android:name="com.example.recetapp.ui.fragments.CreateRecipeFragment"
        android:label="Crear Receta" />

    <fragment
        android:id="@+id/myRecipesFragment"
        android:name="com.example.recetapp.ui.fragments.MyRecipesFragment"
        android:label="Mis Recetas">
        <action
            android:id="@+id/action_myRecipesFragment_to_createRecipeFragment"
            app:destination="@id/createRecipeFragment" />
    </fragment>

</navigation>